; assume probe is < 10mm over starting fiducial
; Assume the A axis is roughly level and C is roughly aligned with slot pointing -X
; Assume the probe is positioned by the mark and in the slot

(MSG, Verify that table is roughly level, slot points -X, probe over startpoint)
M0

G21 F400

#<balldiameter> = 2
#<backoffdistance> = 1.5
#<tableClearance> = 55 ;distance above zRotationCenter to clear table by 5mm

; measured offsets from the probe corner to center of rotation
#<xcorneroffset> = -81.399 ;-82.0 -80.75
#<ycorneroffset> = -49.034;  -48.75 -49.00
#<zcorneroffset> = 33.07;  33.00

#<probexspread> = 30 ;distance between probe points
#<probeyspread> = 60 ;distance between probe points
#<slotwidth> = 8.5

;We will use these numbered parameters to save absolute rotation centers
;in Machine G53 coordinate system
;#4000: x rotation center
;#4001: y rotation center
;#4002: z rotation center

;Probe the frame corner at the fiducial
G91 G38.3 Z-10
G91 G38.4 F50 Z[#<backoffdistance>]
G91 G38.2 F5 Z-[#<backoffdistance>*2]

;Store the result
#4002 = [[#<_abs_z>] - [#<zcorneroffset>]]

;probe left side
;Position the probe
G91 G0 Z10     ; Rapid move Z axis +10mm
G91 G0 X-20    ; Rapid left
G91 G0 Z-15    ; Rapid down to probe position

;Probe the side
G91 G38.3 X20 F400
G91 G38.4 F50 X-[#<backoffdistance>]
G91 G38.2 F5 X[#<backoffdistance> * 2]

;Store the result
#4000 = [[#<_abs_x>] - [#<xcorneroffset>] + [#<balldiameter>/2]]

;probe front side
;position the probe
G91 G0 X-5
G91 G0 Z15
G91 G0 X15 Y-30
G91 G0 Z-25

;Probe the front
G91 G38.3 Y30 F400
G91 G38.4 F50 Y-[#<backoffdistance>]
G91 G38.2 F5 Y[#<backoffdistance> * 2]

;Store the result
#4001 = [[#<_abs_y>] - [#<ycorneroffset>] + [#<balldiameter>/2]]

;calculate expected rotationcenter
#<xRotationCenter> = #4000 
#<yRotationCenter> = #4001 
#<zRotationCenter> = #4002 

(debug,xRotationCenter #<xRotationCenter>)
(debug,yRotationCenter #<yRotationCenter>)
(debug,zRotationCenter #<zRotationCenter>)


; --- Level the A axis using Z probe at two Y positions ---

; Define a Z probing start height above the rotation center
#<zstart> = [[#<zRotationCenter>] + [#<tableClearance>]]


; Move to starting Z height and offset X (to reach surface)
G90
G53 G0 Z[#<zstart>]
G53 G0 X[#<xRotationCenter> - 32] ; Assumes probe offset from center

; --- Probe at Y - (probeyspread / 2) ---
G90
G53 G0 Y[#<yRotationCenter> - [#<probeyspread> / 2]]
G91
G38.2 Z-15 F400               ; Fast probe down
G38.4 F50 Z[#<backoffdistance>]  ; Slow probe up to surface
G38.2 F5 Z[-#<backoffdistance> * 2]          ; Final touch
#1002 = #5063                  ; Store machine Z from probe

; --- Return to Z clearance height ---
G90
G53 G0 Z[#<zstart>]

; --- Probe at Y + (probeyspread / 2) ---
G53 G0 Y[#<yRotationCenter> + [#<probeyspread> / 2]]
G91
G38.2 Z-15 F400
G38.4 F50 Z[#<backoffdistance>]
G38.2 F5 Z[-#<backoffdistance> *2]
#1003 = #5063

; --- Move Z up and away ---
G90
G53 G0 Z[[#<zRotationCenter>] + [#<tableClearance>]]

; --- Calculate angle difference and A correction ---
#1009 = [#1002 - #1003]                     ; Z difference between two probe points
#<acorrection> = [atan[#1009] / [#<probeyspread>]]

(debug, ACorrectionAngle = #<acorrection>)

; Save the current A axis position for relative correction
#<astart> = #5064

; Apply A axis correction
G90
G0 A[#<astart> + #<acorrection>]

; --- Level the C axis using Y probing across the slot ---

; Move to safe probing height and position
G53 G0 Z[[#<zRotationCenter>] + [#<tableClearance>]]
G53 G0 X[#<xRotationCenter> - 32] Y[#<yRotationCenter>]
G53 G1 Z[#<zRotationCenter> + 44] F400

; Slight move to touch the front of slot and establish probing reference
G91 G38.3 Y10 F400

; Store current probing center positions
#<xstart> = [#<xRotationCenter> - 32]
#<zstart> = [#<zRotationCenter> + 44]
#<cstart> = #5066
#<astart> = #5064
#<ystart> = #<yRotationCenter>

; Return to Y center for slot probing
G90
G53 G0 Y[#<ystart>]

; --- Probe at X - (probexspread / 2) ---

G91 G0 X[-[#<probexspread> / 2]]
G38.2 Y10 F400
G38.4 F50 Y[-#<backoffdistance>]
G38.2 F5 Y[#<backoffdistance> *2]
#<yprobe1> = #5062

; --- Return to Y center ---
G90
G53 G0 Y[#<yRotationCenter>]

; --- Probe at X + (probexspread / 2) ---
G91 G0 X[[#<probexspread> / 2]]
G38.2 Y10 F400
G38.4 F50 Y[-#<backoffdistance>]
G38.2 F5 Y[#<backoffdistance> *2]
#<yprobe2> = #5062

; --- Return to center and move up ---
G90
G53 G0 Y[#<yRotationCenter>]
G53 G0 Z[[#<zRotationCenter>] + [#<tableClearance>]]

; --- Calculate correction angle ---
#1009 = [#<yprobe2> - #<yprobe1>]
#<correctionangle> = [atan[#1009] / [#<probexspread>]]

(debug, CCorrectionAngle = #<correctionangle>)

; Optional: fixed offset from probing camera or fixture angle
#<cOffset> = 0
#<finalcpos> = [#<cstart> - #<correctionangle> - #<cOffset>]

; --- Apply rotation to C axis ---
G0 C[#<finalcpos>]

; Move safely to a position 80 mm above the center of rotation
G90
G53 G0 Z[#<zRotationCenter> + [#<tableClearance>]]
G53 G0 X[#<xRotationCenter>] Y[#<yRotationCenter>]

M68 E0 Q#4000
M68 E1 Q#4001
M68 E2 Q#4002


M2
