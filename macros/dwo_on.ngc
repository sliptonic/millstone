o<dwo_on> sub
(MSG, Running DWO_ON)

; Cancel any previous G52 offsets
G52 X0 Y0 Z0

; --- Use probed rotary centers from persistent vars ---
#<x-rot-point> = #4000
#<y-rot-point> = #4001
#<z-rot-point> = #4002

; No static offsets since rotary is removable
#<dy> = 0
#<dz> = 0

; --- Get current work offset position ---
#<x-pos> = #[5221 + [#5220 - 1] * 20]
#<y-pos> = #[5222 + [#5220 - 1] * 20]
#<z-pos> = #[5223 + [#5220 - 1] * 20]

; --- Get current rotary angles ---
#<a_deg> = #<_a>
#<c_deg> = #<_c>

(debug, XROT=#<x-rot-point> YROT=#<y-rot-point> ZROT=#<z-rot-point>)
(debug, XPOS=#<x-pos> YPOS=#<y-pos> ZPOS=#<z-pos>)
(debug, A=#<a_deg> C=#<c_deg>)

; --- Calculate new X position ---
#<new-x-pos> = [+ COS[#<c_deg>] * [#<x-pos> - #<x-rot-point>]]
#<new-x-pos> = [#<new-x-pos> - SIN[#<c_deg>] * [#<y-pos> - #<y-rot-point>]]
#<new-x-pos> = [#<new-x-pos> + #<x-rot-point>]

; --- Calculate new Y position ---
#<new-y-pos> = [+ SIN[#<c_deg>] * COS[#<a_deg>] * [#<x-pos> - #<x-rot-point>]]
#<new-y-pos> = [#<new-y-pos> + COS[#<c_deg>] * COS[#<a_deg>] * [#<y-pos> - #<y-rot-point>]]
#<new-y-pos> = [#<new-y-pos> - SIN[#<a_deg>] * [#<z-pos> - #<z-rot-point>]]
#<new-y-pos> = [#<new-y-pos> + #<y-rot-point>]

; --- Calculate new Z position ---
#<new-z-pos> = [+ SIN[#<c_deg>] * SIN[#<a_deg>] * [#<x-pos> - #<x-rot-point>]]
#<new-z-pos> = [#<new-z-pos> + COS[#<c_deg>] * SIN[#<a_deg>] * [#<y-pos> - #<y-rot-point>]]
#<new-z-pos> = [#<new-z-pos> + COS[#<a_deg>] * [#<z-pos> - #<z-rot-point>]]
#<new-z-pos> = [#<new-z-pos> + #<z-rot-point>]

(debug, NEW_X=#<new-x-pos>)
(debug, NEW_Y=#<new-y-pos>)
(debug, NEW_Z=#<new-z-pos>)

; --- Apply the delta as a G52 offset ---
G52 X[#<new-x-pos> - #<x-pos>] Y[#<new-y-pos> - #<y-pos>] Z[#<new-z-pos> - #<z-pos>]

(debug, DWO G52 X[#<new-x-pos> - #<x-pos>])
(debug, DWO G52 Y[#<new-y-pos> - #<y-pos>])
(debug, DWO G52 Z[#<new-z-pos> - #<z-pos>])

o<dwo_on> endsub

