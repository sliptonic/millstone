O<probe_left> sub

#<probe_diameter> = 2.0
#<probe_radius>   = [#<probe_diameter> / 2.0]
#<edge_offset>    = 5.0
#<backoff>        = 0.254

G21

; Fast probe
G91 G38.2 F400 X+10

; Back off
G90 G0 X[#5061-#<backoff>]

; Slow probe
G91 G38.2 F5 X+0.5

; Retract to desired offset from edge
G90 G0 X[#5061-[#<edge_offset>-#<probe_radius>]]

(debug,Spindle center is X-#<edge_offset> from the edge)

O<probe_left> endsub
M2
